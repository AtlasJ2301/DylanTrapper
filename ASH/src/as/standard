// AS_IO

//    DESCRIPTION:
//
//  as/IO is a tool to help with input and output
//  in your project.
//
//
//  USAGE:
//  
//  clear(): Clears the screen of any text.
//
//  msleep(int): Makes program stop for specific
//  amount of milliseconds.
//
//  sleep(int): Makes program stop for specific 
//  amount of seconds.
//
//  termMode(int): changes tty to:
//  0 - sane
//  1 - raw
//  2 - -echo

#include <cstdio>

namespace as
{
  extern "C" { int printf(const char *format, ...); } 
  extern "C" { int scanf(const char *format, ...); } // Requires char* variable.
  extern "C" { int getchar(); }
  extern "C" { void system(const char*); }
  extern "C" { int usleep(int); }
  extern "C" { int fflush(FILE* stream); }

  #define getin(out) termMode(1); out = as::getchar(); as::termMode(0); \
  if (out == 27) { \
    as::termMode(1); \
    as::getchar(); \
    out = as::getchar(); \
    as::termMode(0); \
  }
  #define sleep(sec) fflush(stdout); as::usleep(sec * 1000000)
  #define msleep(sec) fflush(stdout); as::usleep(sec * 1000)
  #define clearscr printf("\033[2J\033[1;1H")
  #define sleep_clear(sec) sleep(sec); clear
  #define msleep_clear(sec) msleep(sec); clear
  
  void termMode(int mode)
  {
  #ifdef __linux__
    if (mode == 0) system("stty sane");
    if (mode == 1) system("stty raw");
    if (mode == 2) system("stty -echo");
  #endif
  }

  #ifdef AS_LANG_SPANISH
  #define mdormir msleep
  #define termModo termMode
  #define despejar clear
  #endif
};

// AS_CCMATH

namespace as {
#define poder power
  int power(int num1, int num2) 
  {
    const int first = num1;
    for (int i = 0; i < num2 - 1; i++) num1 *= first;
    return num1;
  }
}

