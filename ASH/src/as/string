  char tmp[4096];

  char int_to_letter(int num)
  {
    char tmp;
    if (num > 0 && num < 27)
    {
      num += 96;
      tmp = num;
    }
    return tmp;
  }

  char* int_to_letters(int num)
  {
    int digit, i = 0;
    for (; num != 0; i++) {
      digit = num % 100;
      tmp[i] = int_to_letter(digit);
      num /= 100;
    }
    tmp[i + 1] = '\0';

    return tmp;
  }

  char itch(int num)
  {
    char tmp = num + '0';
    return tmp;
  }

  char int_to_char(int num)
  {
    char tmp = (char)num;
    return tmp;
  }

  int csize(char val[]) {
    int i;
    for (i = 0; val[i] != '\0'; i++);
    return i;
  }

  struct string {
    char val[4096];

    void clean() { for (int i = 0; i <= 4096; i++) val[i] = '\0'; }

    
    void style(int highlight)
    {
      //  Must go in order of:
      //    1. Formatting
      //    2. Text Color
      //    3. Background Color
      string tmp;
      if (highlight == 0)
      {
        int i;
        while (val[0] == '\x1b') {
          i = 0;
          tmp.clean();
          for (; val[i] != 'm'; i++);
          i++;
          for (int j = i; j < csize(val); j++) {
            tmp.add(val[j]);
          }

          clean();
          int i;
          for (i = 0; tmp.val[i] != '\0'; i++) val[i] = tmp.val[i];
          val[i + 1] = '\0';
        }
      } else {
        tmp.set("\x1b[");
        tmp.append(highlight);
        tmp.add('m');
        tmp.append(val);
        tmp.append("\x1b[0m");
        tmp.add('\0');
        clean();
        for (int i = 0; tmp.val[i] != '\0'; i++) val[i] = tmp.val[i];
      }
    }

    // cmp //
      bool cmp(string str)
      {
        int sizeo;
        sizeo = csize(val);
        if (str.size() > sizeo) {
          sizeo = str.size();
        }
        
        for (int i = 0; i < sizeo; i++)
        {
          if (str.val[i] != val[i]) return false;
        }
        return true;
      }
    // cmp //

    // set //
      void set(const char* content)
      {
        clean();
        int i;
        for (i = 0; content[i] != '\0'; i++) val[i] = content[i];
        val[i + 1] = '\0';
      }

      void set(as::string content)
      {
        clean();
        int i;
        for (i = 0; content.val[i] != '\0'; i++) val[i] = content.val[i];
        val[i + 1] = '\0';
      }

      void set(char content)
      {
        clean();
        val[0] = content;
        val[1] = '\0';
      }
    // set //

    // add //
      void add(char content)
      {
        val[csize(val)] = content;
        val[csize(val)] = '\0';
      }

      void add(int num) { val[csize(val)] = num + '0'; }
    // add //


    void erase(int from, int to)
    {
      char tmp[4096];
      for ( int i = from + to; i <= csize(val); i++ ) tmp[i] = val[i];
      for ( int i = from; i + to <= csize(tmp); i++ ) val[i] = tmp[i + to];
      val[csize(val)] = '\0';
      
    }

    void eraseafter(int from)
    {
      int size = csize(val);
      for ( int i = from; i <= size; i++ ) val[i] = '\0';
    }

    void erasebefore(int from)
    {
      char tmp[4096];
      int size = csize(val);
      for (int i = from; i <= size; i++)
      {
        val[i - from] = val[i]; 
      }
    }

    int whereis(char chr, int start)
    {
      for (int i = start; i <= csize(val); i++ ) 
      {
        if (val[i] == chr) return i;
      }
      return -1;
    }

    string until(char chr, int start)
    {
      string tmp;
      tmp.clean();
      for (int i = start; i <= 4096; i++)
      {
        if (val[i] == chr) return tmp;
        tmp.val[i - start] = val[i];
      }
      tmp.clean();
      return tmp;
    }

    string until(int len, int start)
    {
      string tmp;
      tmp.clean();
      for (int i = start; i <= len + start; i++)
      {
        tmp.val[i - start] = val[i];
      }
      return tmp;
    }
    
    // append //
      void append(const char* content) 
      {
        int i;
        for (i = 0; content[i] != '\0'; i++) add(content[i]);
        val[csize(val)] = '\0';
      }

      void append(as::string content) 
      {
        int i;
        for (i = 0; content.val[i] != '\0'; i++) add(content.val[i]);
        val[csize(val)] = '\0';
      }

      void append(int num)
      {
        int i = 0;

        char tmp[4096];

        while (num != 0) {
          int digit = num % 10;
          tmp[i++] = itch(digit);
          num /= 10;
        }

        for (char a = tmp[i]; i >= 0; i--)
        {
          a = tmp[i];
          if ( a == '0' || a == '1' || a == '2' || a == '3' || a == '4' || a == '5' || a == '6' || a == '7' || a == '8' || a == '9') add(tmp[i]);
        }
      }
    // append //

    int size() {
      return csize(val);
    }
  };

  #define print(str) printf("%s", str.val)

  // swap //
    void swap(string &str1, string &str2)
    {
      string buf1;
      string buf2;
      buf1.set(str1.val);
      buf2.set(str2.val);
      str1.set(buf2.val);
      str2.set(buf1.val);
    }

    void swap(int &int1, int &int2)
    {
      int buf = int1;
      int1 = int2;
      int2 = buf;
    }
  // swap //
}

