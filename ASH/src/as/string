//  object = {"Value"};
//
//
//  str.add(char): Adds one character to the end 
//  of a string.
//
//  str.append(const char*): Adds a const char* 
//  to the end of a string.
//
//  str.clean(): Fills the string value with a 
//  null terminator.
//
//  str.set(const char*): Sets the string to a
//  desired value.
//
//  str.size(): Returns the size of the string as
//  an integer.
//
//  str.val: Returns the value of the string.

