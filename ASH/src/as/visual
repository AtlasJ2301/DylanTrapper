    void makeLine(position pos1, position pos2, int ang)
    {
      if (pos1.X > pos2.X) swap(pos1.X, pos2.X);
      if (pos1.Y > pos2.Y) swap(pos1.Y, pos2.Y);

      if (ang < 23) // Vertical Line
      {
        for ( int y = pos1.Y; y <= pos2.Y; y++ ) pixel[pos1.X][pos1.Y + y] = 1;
      }
      else if (ang > 23 && ang < 68)
      {
        for ( int i = 0; pos1.Y + i <= pos2.Y && pos1.X + i <= pos2.X; i++ ) pixel[pos1.X + i][pos1.Y + i] = 1;
      }
      else if (ang > 68 && ang < 91) // Vertical Line
      {
        for ( int x = pos1.X; x <= pos2.X; x++ ) pixel[pos1.X + x][pos1.Y] = 1;
      }
    }
    void display()
    {
      position postmp = pos;
      draw({postmp.X + 1, postmp.Y + 1});
      int tmp[8] = { defaultState, defaultState, defaultState, defaultState, defaultState, defaultState, defaultState, defaultState };
      string format;
      for ( int i = 0; i < size.Y; i++ )
      {
        for ( int j = 0; j < size.X; j++ )
        {

          for ( int y = 0; y < 4; y++ )
          {
            for ( int x = 0; x < 2; x++ )
            {
              if (pixel[x + j*2][y + i*4]) tmp[ y * 2 + x ] = pixelOn;
            }
          }

          format.set(toBraille(tmp).val);
          format.style(foreground_color);
          format.style(background_color);
          print(format);
          repeat(8) { 
            tmp[INTERNAL_REPEAT_VARIABLE] = defaultState; 
          }
        }
        postmp.Y++;
        draw({postmp.X + 1, postmp.Y + 1});
      }
    }

    void clearBuffer() {
      for (int i = 0; i <= size.Y*4; i++)
      {
        for (int j = 0; j <= size.X*2; j++)
        {
          pixel[j][i] = 0;
          backgroundPixel[j][i] = 0;
        }
      }
    }

    void cleanSection(position pos1, position pos2)
    {
      for ( int i = pos1.Y; i <= pos2.Y; i++ )
      {
        for ( int j = pos1.X; j <= pos2.X; j++ ) pixel[j][i] = defaultState;
      }
    }

    void display_clearBuffer() { display(); clearBuffer(); }
