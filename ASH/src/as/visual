  struct position 
  {

    int X;
    int Y;
  };

  void draw(position pos) 
  {

    printf("%s", "\e[");
    printf("%d", pos.Y);
    printf("%s", ";");
    printf("%d", pos.X);
    printf("%s", "H");

    return;
  }

  void drawPoint(position pos, string msg) 
  {

    printf("%s", "\e[");
    printf("%d", pos.Y);
    printf("%s", ";");
    printf("%d", pos.X);
    printf("%s", "H");

    printf("%s", msg.val);

    return;
  }

  void drawSquare(position pos1, position pos2, char text)
  {

    if (pos1.X > pos2.X) swap(pos1.X, pos2.X);
    if (pos1.Y > pos2.Y) swap(pos1.Y, pos2.Y);

    for (int Y = pos1.Y; Y <= pos2.Y; Y++) 
    {
      draw({pos1.X, Y});

      for (int X = pos1.X; X <= pos2.X; X++) printf("%c", text);
    }
  }

  string boxVertLine = {"│"}, boxHorzLine = {"─"}, boxTopLCorn = {"┌"}, boxTopRCorn = {"┐"}, boxBotLCorn = {"└"}, boxBotRCorn = {"┘"};

  void setBoxLine(string vertline, string horzline, string topl, string topr, string botl, string botr) { boxVertLine = vertline, boxHorzLine = horzline, boxTopLCorn = topl, boxTopRCorn = topr, boxBotLCorn = botl, boxBotRCorn = botr; }

  void boxDecor(int style)
  {

    if (style == 0) setBoxLine({"│"}, {"─"}, {"┌"}, {"┐"}, {"└"}, {"┘"});
    else if (style == 1) setBoxLine({"┃"}, {"━"}, {"┏"}, {"┓"}, {"┗"}, {"┛"});
    else if (style == 2) setBoxLine({"║"}, {"═"}, {"╔"}, {"╗"}, {"╚"}, {"╝"});
  }

  void drawBox(position pos1, position pos2)
  {
    
    if (pos1.X > pos2.X) swap(pos1.X, pos2.X);
    if (pos1.Y > pos2.Y) swap(pos1.Y, pos2.Y);

    drawPoint(pos1, boxTopLCorn);

    for (int i = pos1.X + 1; i < pos2.X; i++) printf("%s", boxHorzLine.val);

    printf("%s", boxTopRCorn.val);

    for (int i = 1; i < pos2.Y - pos1.Y; i++) 
    {

      drawPoint({pos1.X, pos1.Y + i}, boxVertLine);
      drawPoint({pos2.X, pos1.Y + i}, boxVertLine);
    }

    drawPoint({pos1.X, pos2.Y}, boxBotLCorn);

    for (int i = pos1.X + 1; i < pos2.X; i++) printf("%s", boxHorzLine.val);
    
    printf("%s", boxBotRCorn.val);
  }

