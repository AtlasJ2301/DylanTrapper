  struct object
  {
    
    string line[200];
    position pos = {0, 0}; // I swapped these and built two whole animations and more with them... fuck.
    position size;

    int cutoffL = 0, cutoffR = 999, cutoffT = 0, cutoffB = 999; 

    void addPos(position posit) { pos = {pos.X + posit.X, pos.Y + posit.Y}; }

    void subPos(position posit) { pos = {pos.X - posit.X, pos.Y - posit.Y}; }

    void drawOBJ()
    {
      
      for (int i = 0; i < size.X; i++) // Actually Y pos
      {

        for (int j = 0; j < size.Y; j++) // Actually X pos
        {
          if (pos.X + j > cutoffL && pos.X + j < cutoffR && pos.Y + i < cutoffB && pos.Y + i > cutoffT)
          {

            draw({pos.X + j, pos.Y + i});
            printf("%c", line[i].val[j]);
          }
        }
      }
    }

    void drawOBJPos(position posadd)
    {
      
      for (int i = 0; i < size.X; i++)
      {

        for (int j = 0; j < size.Y; j++)
        {
          if (pos.X + j + posadd.X > cutoffL && pos.X + j + posadd.X < cutoffR && pos.Y + i + posadd.Y < cutoffB && pos.Y + i + posadd.Y > cutoffT)
          {
            draw({pos.X + j + posadd.X, pos.Y + i + posadd.Y});
            printf("%c", line[i].val[j]);
          }
        }
      }
    }

    void drawOBJPosRev(position posadd)
    {

      int k;
      
      for (int i = 0; i < size.X; i++)
      {

        k = size.Y - 1;

        for (int j = 0; j < size.Y; j++)
        {

          draw({pos.X + j + posadd.X, pos.Y + i + posadd.Y});
          printf("%c", line[i].val[k]);

          k--;
        }
      }
    }
  };

