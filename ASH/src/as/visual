// TTY //
  struct tty {
    string out[100];
    screen terminal, character, underline;
    
    string inject;

    bool psrvInjection = true;

    position mousepos;

    string* init_tty(position termsize) {
      int chrpos = 0;
      for (int i = 0; i < 100; i++) out[i].clean();
      terminal.size = termsize;
      character.size = {3, 1};
      character.pos = {terminal.pos.X, terminal.pos.Y};
      character.background_color = terminal.background_color;
      underline.background_color = terminal.background_color;
      character.foreground_color = terminal.foreground_color;
      underline.foreground_color = terminal.foreground_color;
      underline.size = {3, 1};
      underline.makeLine({0,3}, {3,3}, 90);
      int xcap = termsize.X * 2;
      int height = 0, tty_input;
      bool isInsert = 0;
      terminal.display();  
      underline.display();
      for (int j = 0; inject.val[j] != '\0'; j++)
      {
        character.makeText(inject.val[j], {0, 0});
        chrpos += 6;
        character.display_clearBuffer();
        if (chrpos >= xcap || inject.val[j] == '\n') {
          height += 1;
          chrpos = 0;
        }
        if (psrvInjection == true) out[height].add(inject.val[j]);
        character.pos = {chrpos/2 + terminal.pos.X, height + terminal.pos.Y};
      }
      while (tty_input != CTRL_C)
      {
        // as::draw({50,10}); as::printf("%i", tty_input);
        as::draw({termsize.X - 1, termsize.Y - 1});
        as::getin(tty_input);
        if (tty_input == '\\') {
          as::getin(tty_input);
          if (tty_input == 'n') {
            out[height].add('\n');
            height += 1;
            chrpos = 0;
          }
        } else if (tty_input == CTRL_P) {
          out[height + 1].add('\1'); // Add EOT Character
          return out;
        } else if (tty_input == KEY_HOME) {
          terminal.display();
          for (int i = 0; i < 100; i++) out[i].clean();
          chrpos = 0;
          height = 0;
        } else if (tty_input == KEY_INSERT)
        {
          if (isInsert == 0) {
            isInsert = 1;
          }
          else if (isInsert == 1) { 
            isInsert = 0;
          }
        } else if (tty_input == KEY_BACKSPACE)
        {
          out[height].erase(out[height].size() - 1, 1);
          character.display();
          chrpos -= 6;
          if (chrpos < 0) 
          {
            if (height > 0) {
              height--;
              chrpos = out[height].size() * 6 - 6;
            } else chrpos = 0; 
          }
        } else if (tty_input == KEY_UP) {
          character.display();
          if (height > 0) {
            height--;
          } 
          chrpos = out[height].size() * 6 - 6;
        } else if (tty_input == KEY_DOWN) {
          character.display();
          height++;
          chrpos = out[height].size() * 6 - 6;
        } else if (tty_input != CTRL_C) {
          character.makeText(tty_input, {0, 0});
          chrpos += 6;
          character.display_clearBuffer();
          if (tty_input == KEY_ENTER || chrpos >= xcap) {
            height += 1;
            chrpos = 0;
          } else out[height].add(int_to_char(tty_input));
        }
        character.pos = {chrpos/2 + terminal.pos.X, height + terminal.pos.Y};
        underline.pos = character.pos;
        underline.display();
      }
      return NULL;
    }
  };

