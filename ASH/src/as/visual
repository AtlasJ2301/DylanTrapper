    void append(screen scr)
    {
      for ( int i = 0; i <= scr.size.Y*4; i++ )
      {
        for (int j = 0; j <= scr.size.X*2; j++ )
        {
          backgroundPixel[j][i] = scr.pixel[j + scr.pos.X][i + scr.pos.Y];
          if (scr.pixel[j][i]) pixel[j + scr.pos.X][i + scr.pos.Y] = 1;
        }
      }
    }

    void setDefaultState(bool input)
    {
      if (input) { defaultState = 1; pixelOn = 0; }
      else { defaultState = 0; pixelOn = 1; }
    }

    void makeBox(position pos1, position pos2)
    {
      for ( int i = pos1.X; i <= pos2.X; i++ ) { pixel[i][pos1.Y] = 1; pixel[i][pos2.Y] = 1; }
      for ( int i = pos1.Y; i <= pos2.Y; i++ ) { pixel[pos1.X][i] = 1; pixel[pos2.X][i] = 1; }
    }
    
    void makeSquare(position pos1, position pos2)
    {
      for ( int i = pos1.Y; i <= pos2.Y; i++ ) { 
        for ( int j = pos1.X; j <= pos2.X; j++ ) { 
          pixel[j][i] = 1;
        }
      }
    }

