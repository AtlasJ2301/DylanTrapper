  void menuInit(int count, int amount) 
  {
    clearscr;
    
    select[0] = 0;
    select[1] = 0;

    for (int j = 0; j < amount; j++) 
    {

      for (int i = 0; i < count; i++) 
      {

        as::draw({pos[j].X, pos[j].Y + i});

        if (i == select[0] && j == select[1]) 
        {

          printf("%s%d%s", "\x1b[", highlight, "m");
        }

        printf("%s%s", option[i][j].val, "\x1b[0m");

      }
    }
  }

  int menu(int count, int amount) 
  {

    termMode(1);
    getin(ch);

    if (ch == 65) // Keystroke Up
    {

      selecttmp = select[0];
      select[0]--; 

      if (select[0] == -1) select[0] = count - 1;

      while (exclude[select[0] + select[1] * count] == true) // This is the exclude math. 
      {
        
        select[0]--;

        if (select[0] == -1) select[0] = count - 1;

      }

    } 
    else if (ch == 66) // Keystroke Down
    {

      select[0]++; 

      if (select[0] == count) select[0] = 0;

      while (exclude[select[0] + select[1] * count] == true) 
      {
        
        select[0]++;
        if (select[0] == count) select[0] = 0;

      }

    } 
    else if (ch == 67) // Keystroke Left
    {

      select[1]++; 
      if (select[1] == amount) select[1] = 0;

      while (exclude[select[0] + select[1] * count] == true) 
      {

        select[1]++;
        if (select[1] == amount) select[1] = 0;
       
      }

    } 
    else if (ch == 68) // Keystroke Right
