  void resize(int Width, int Height) 
  {

    string buf;
    char buffer[4];

    while (1) 
    {

      as::clearscr;
      drawPoint({1, 1}, {"XXXX"});
      drawPoint({1, 2}, {"X"});
      drawPoint({1, 3}, {"X"});
      drawPoint({1, 4}, {"X"});
      drawPoint({Width - 3, 1}, {"XXXX"});
      drawPoint({Width, 2}, {"X"});
      drawPoint({Width, 3}, {"X"});
      drawPoint({Width, 4}, {"X"});
      drawPoint({1, Height}, {"XXXX"});
      drawPoint({1, Height - 1}, {"X"});
      drawPoint({1, Height - 2}, {"X"});
      drawPoint({1, Height - 3}, {"X"});
      drawPoint({Width - 3, Height}, {"XXXX"});
      drawPoint({Width, Height - 1}, {"X"});
      drawPoint({Width, Height - 2}, {"X"});
      drawPoint({Width, Height - 3}, {"X"});
      drawPoint({Width / 2 - 27, Height / 2 - 1}, {"Please resize your terminal until it is size "});
      printf("%d", Width);
      printf("%s", " x ");
      printf("%d", Height);
      drawPoint({Width / 2 - 32, Height / 2}, {"Type \"exit\" to finish or press ENTER to refresh the screen: _______"});
      draw({Width / 2 + 28, Height / 2});
      buf.clean();
      scanf("%5s", buf.val);
      if (buf.cmp({"exit"})) break;
    }

    clearscr;
  }

